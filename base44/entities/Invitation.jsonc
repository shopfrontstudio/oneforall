{
  "name": "Invitation",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string",
      "description": "Safe service label, never customer-authored title text."
    },
    "service_key": { "type": "string" },
    "selected_scope_ids": { "type": "array", "items": { "type": "string" } },
    "selected_scope_labels": { "type": "array", "items": { "type": "string" } },
    "service_area": { "type": "string" },
    "preferred_date": { "type": "string", "format": "date" },
    "urgency": { "type": "string", "enum": ["flexible", "this_week", "urgent"] },
    "indicative_low": { "type": "number" },
    "indicative_high": { "type": "number" },
    "policy_version": { "type": "string" },
    "customer_id": {
      "type": "string",
      "description": "Routing identifier hidden from the invited provider.",
      "rls": {
        "read": {
          "$or": [
            { "data.customer_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      }
    },
    "customer_name": {
      "type": "string",
      "description": "Deprecated private field retained for historic records; new invitations never write it.",
      "rls": {
        "read": {
          "$or": [
            { "data.customer_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      }
    },
    "tradie_id": {
      "type": "string"
    },
    "tradie_name": {
      "type": "string"
    },
    "provider_assertion_id": { "type": "string" },
    "provider_assertion_evidence_checked_date": { "type": "string", "format": "date" },
    "provider_assertion_valid_through": { "type": "string", "format": "date" },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "responded",
        "declined"
      ],
      "default": "pending"
    },
    "quote_low": {
      "type": "number"
    },
    "quote_high": {
      "type": "number"
    },
    "earliest_availability": {
      "type": "string",
      "format": "date"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "customer_id",
    "tradie_id",
    "status"
  ],
  // Providers receive only the minimal safe request snapshot above. Responses go
  // through respond-invitation, which re-reads the private Job under service role
  // only after proving the caller owns this invitation.
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$and": [
        { "user_condition": { "id": "{{user.id}}" } },
        {
          "$or": [
            { "data.customer_id": "{{user.id}}" },
            { "data.tradie_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
