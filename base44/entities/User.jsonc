{
  "properties": {
    "account_type": {
      "type": "string",
      "description": "The active marketplace experience for this user",
      "enum": [
        "customer",
        "tradie"
      ],
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "account_standing": {
      "type": "string",
      "description": "Server-owned operational standing used by marketplace eligibility.",
      "enum": ["active", "suspended", "closed"],
      "default": "active",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ],
      // Account experience changes now pass through set-account-type, while role
      // remains admin-owned. Otherwise a crafted user update could grant admin,
      // which protected writes and every admin RLS condition trust.
      "rls": {
        "update": { "user_condition": { "role": "admin" } }
      }
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}
