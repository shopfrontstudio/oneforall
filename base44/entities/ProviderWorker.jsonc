{
  "name": "ProviderWorker",
  "type": "object",
  "properties": {
    "provider_id": { "type": "string" },
    "display_name": { "type": "string" },
    "legal_name": { "type": "string" },
    "identity_verified": { "type": "boolean", "default": false },
    "relationship_verified": { "type": "boolean", "default": false },
    "is_subcontractor": { "type": "boolean", "default": false },
    "subcontractor_separately_verified": { "type": "boolean", "default": false },
    "active": { "type": "boolean", "default": false },
    "reviewed_by": { "type": "string" },
    "reviewed_at": { "type": "string", "format": "date-time" }
  },
  "required": ["provider_id", "display_name"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "$or": [{ "data.provider_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
