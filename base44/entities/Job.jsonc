{
  "name": "Job",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_suburb": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category_slug": {
      "type": "string"
    },
    "category_name": {
      "type": "string"
    },
    "suburb": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "default": "VIC"
    },
    "preferred_date": {
      "type": "string",
      "format": "date"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "flexible",
        "this_week",
        "urgent"
      ],
      "default": "flexible"
    },
    "access_notes": {
      "type": "string"
    },
    "parking": {
      "type": "string",
      "enum": [
        "on_street",
        "driveway",
        "none"
      ],
      "default": "on_street"
    },
    "safety_info": {
      "type": "string"
    },
    "budget": {
      "type": "number"
    },
    "indicative_low": {
      "type": "number"
    },
    "indicative_high": {
      "type": "number"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "matched",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "draft"
    },
    "boosted": {
      "type": "boolean",
      "default": false
    },
    "assigned_tradie_id": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "title",
    "category_slug"
  ]
}