{
  "name": "Job",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer's real name. Only the customer and the tradie they accepted may read it.",
      "rls": {
        "read": {
          "$or": [
            { "data.customer_id": "{{user.id}}" },
            { "data.assigned_tradie_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      }
    },
    "customer_suburb": {
      "type": "string",
      "description": "Customer's home suburb. Not needed to quote — `suburb` carries the job location.",
      "rls": {
        "read": {
          "$or": [
            { "data.customer_id": "{{user.id}}" },
            { "data.assigned_tradie_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      }
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category_slug": {
      "type": "string"
    },
    "category_name": {
      "type": "string"
    },
    "service_key": { "type": "string" },
    "service_pathway": { "type": "string", "enum": ["scheduled_or_recurring", "managed_quote", "licensed_diagnostic"] },
    "policy_version": { "type": "string" },
    "request_idempotency_key": { "type": "string" },
    "recurrence_requested": { "type": "boolean", "default": false },
    "recurrence_frequency": { "type": "string", "enum": ["weekly", "fortnightly", "monthly", "custom"] },
    "scope_decision": { "type": "string", "enum": ["allowed", "manual_review", "blocked"] },
    "scope_reason": { "type": "string" },
    "hazard_screen_status": { "type": "string", "enum": ["pending", "passed", "manual_review", "blocked"], "default": "pending" },
    "accepted_quote_id": {
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "booking_id": {
      "type": "string",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "suburb": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "default": "VIC"
    },
    "preferred_date": {
      "type": "string",
      "format": "date"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "flexible",
        "this_week",
        "urgent"
      ],
      "default": "flexible"
    },
    "access_notes": {
      "type": "string",
      "description": "How to get onto the property (gates, keys, dogs). Never expose to tradies who have not been accepted.",
      "rls": {
        "read": {
          "$or": [
            { "data.customer_id": "{{user.id}}" },
            { "data.assigned_tradie_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      }
    },
    "parking": {
      "type": "string",
      "enum": [
        "on_street",
        "driveway",
        "none"
      ],
      "default": "on_street"
    },
    "safety_info": {
      "type": "string",
      "description": "Site/occupant safety details. Same disclosure boundary as access_notes.",
      "rls": {
        "read": {
          "$or": [
            { "data.customer_id": "{{user.id}}" },
            { "data.assigned_tradie_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      }
    },
    "budget": {
      "type": "number",
      "description": "The customer's private ceiling. Tradies quote against indicative_low/indicative_high instead.",
      "rls": {
        "read": {
          "$or": [
            { "data.customer_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      }
    },
    "indicative_low": {
      "type": "number"
    },
    "indicative_high": {
      "type": "number"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "matched",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "draft",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "boosted": {
      "type": "boolean",
      "default": false,
      "description": "Set by the boost-job function once the monthly quota and cooldown pass.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "assigned_tradie_id": {
      "type": "string",
      "description": "Written only by accept-interest. This field releases access_notes and customer_name, so it must not be settable directly.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    }
  },
  "required": [
    "customer_id",
    "title",
    "category_slug"
  ],
  // Every rule is wrapped in an authentication check: `true` in Base44 RLS means
  // "including anonymous/unauthenticated", so a bare `data.*` condition must never
  // be the only gate on a job board that carries photos of people's homes.
  // Browsing is limited to `published` — once a job is matched it is only visible
  // to the customer and the tradie they accepted.
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$and": [
        { "user_condition": { "id": "{{user.id}}" } },
        {
          "$or": [
            { "data.customer_id": "{{user.id}}" },
            { "data.assigned_tradie_id": "{{user.id}}" },
            { "data.status": "published" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
