{
  "name": "Review",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "reviewee_id": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "body": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "customer_to_tradie",
        "tradie_to_customer"
      ]
    }
  },
  "required": [
    "job_id",
    "reviewer_id",
    "reviewee_id",
    "rating"
  ],
  // submit-review is the only writer: it proves the caller posted the job, that the
  // job is completed, that they have not already reviewed it, and it derives
  // reviewer_id / reviewee_id itself. That is the review-bombing fix — RLS cannot
  // check a relationship that lives in another entity.
  //
  // reviewer_name is a real name, so reading requires a session rather than `true`,
  // which in Base44 would include anonymous callers.
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "user_condition": { "id": "{{user.id}}" } },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
