{
  "name": "TradieProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "abn": {
      "type": "string"
    },
    "trade_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "licence_number": {
      "type": "string",
      "description": "Trade licence credential. Public pages show licence_type instead, so this stays with its owner.",
      "rls": {
        "read": {
          "$or": [
            { "data.user_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      }
    },
    "licence_type": {
      "type": "string"
    },
    "insurance_provider": {
      "type": "string"
    },
    "insurance_policy_number": {
      "type": "string",
      "description": "Insurance policy credential — enough to impersonate the tradie to their insurer. Owner and admin only.",
      "rls": {
        "read": {
          "$or": [
            { "data.user_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      }
    },
    "public_liability": {
      "type": "boolean",
      "default": false
    },
    "qualifications": {
      "type": "string"
    },
    "experience_years": {
      "type": "number",
      "default": 0
    },
    "service_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service_radius_km": {
      "type": "number",
      "default": 20
    },
    "open_to_work": {
      "type": "boolean",
      "default": true
    },
    "bio": {
      "type": "string"
    },
    "portfolio_photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avatar_url": {
      "type": "string"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Platform-granted trust badge. Must never be self-awarded.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "founding_badge": {
      "type": "boolean",
      "default": false,
      "description": "Platform-granted badge. Must never be self-awarded.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "rating_avg": {
      "type": "number",
      "default": 0,
      "description": "Derived from Review records. Self-writable ratings would make the star display meaningless.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "rating_count": {
      "type": "number",
      "default": 0,
      "description": "Derived from Review records. See rating_avg.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "suburb": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "default": "VIC"
    }
  },
  "required": [
    "user_id",
    "full_name"
  ],
  // The tradie directory is a signed-in feature (every route sits behind
  // ProtectedRoute), so read requires a session rather than `true`, which would
  // publish every tradie's name, suburb and user_id to anonymous callers.
  // Writes are pinned to created_by so a forged record cannot shadow a real one.
  "rls": {
    "create": { "user_condition": { "id": "{{user.id}}" } },
    "read": {
      "$or": [
        { "user_condition": { "id": "{{user.id}}" } },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            { "created_by": "{{user.email}}" },
            { "data.user_id": "{{user.id}}" }
          ]
        },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            { "created_by": "{{user.email}}" },
            { "data.user_id": "{{user.id}}" }
          ]
        },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
