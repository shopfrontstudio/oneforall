{
  "name": "TradieProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "abn": {
      "type": "string"
    },
    "trade_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "licence_number": {
      "type": "string"
    },
    "licence_type": {
      "type": "string"
    },
    "insurance_provider": {
      "type": "string"
    },
    "insurance_policy_number": {
      "type": "string"
    },
    "public_liability": {
      "type": "boolean",
      "default": false
    },
    "qualifications": {
      "type": "string"
    },
    "experience_years": {
      "type": "number",
      "default": 0
    },
    "service_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service_radius_km": {
      "type": "number",
      "default": 20
    },
    "open_to_work": {
      "type": "boolean",
      "default": true
    },
    "bio": {
      "type": "string"
    },
    "portfolio_photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avatar_url": {
      "type": "string"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "founding_badge": {
      "type": "boolean",
      "default": false
    },
    "rating_avg": {
      "type": "number",
      "default": 0
    },
    "rating_count": {
      "type": "number",
      "default": 0
    },
    "suburb": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "default": "VIC"
    }
  },
  "required": [
    "user_id",
    "full_name"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": { "data.user_id": "{{user.id}}" },
    "delete": { "data.user_id": "{{user.id}}" }
  }
}
