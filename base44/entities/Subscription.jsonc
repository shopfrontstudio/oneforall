{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "tradie_id": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "local",
        "pro"
      ],
      "default": "free"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "cancelled",
        "trial"
      ],
      "default": "trial"
    },
    "started_date": {
      "type": "string",
      "format": "date-time"
    },
    "expires_date": {
      "type": "string",
      "format": "date-time"
    },
    "founding_trial": {
      "type": "boolean",
      "default": false
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "tradie_id",
    "plan"
  ],
  "rls": {
    "create": true,
    "read": { "data.tradie_id": "{{user.id}}" },
    "update": { "data.tradie_id": "{{user.id}}" },
    "delete": { "data.tradie_id": "{{user.id}}" }
  }
}
