{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "tradie_id": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "local",
        "pro"
      ],
      "default": "free"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "cancelled",
        "trial"
      ],
      "default": "trial"
    },
    "started_date": {
      "type": "string",
      "format": "date-time"
    },
    "expires_date": {
      "type": "string",
      "format": "date-time"
    },
    "founding_trial": {
      "type": "boolean",
      "default": false
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "tradie_id",
    "plan"
  ],
  // Entitlement is read as `filter({ tradie_id })[0]`, so a record planted by
  // another account with the victim's tradie_id could shadow their real plan.
  // created_by is server-stamped, so a forged row is invisible to the victim.
  //
  // NOTE: plan/status are still written by the client (see Membership.jsx, which
  // is a clearly-labelled demo billing flow). Before real payments are taken these
  // fields must move behind a backend function keyed to the payment provider —
  // RLS alone cannot tell a paid upgrade from a self-granted one.
  "rls": {
    "create": { "user_condition": { "id": "{{user.id}}" } },
    "read": {
      "$or": [
        {
          "$and": [
            { "created_by": "{{user.email}}" },
            { "data.tradie_id": "{{user.id}}" }
          ]
        },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$and": [
        { "created_by": "{{user.email}}" },
        { "data.tradie_id": "{{user.id}}" }
      ]
    },
    "delete": {
      "$and": [
        { "created_by": "{{user.email}}" },
        { "data.tradie_id": "{{user.id}}" }
      ]
    }
  }
}
