{
  "name": "CustomerProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "suburb": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "default": "VIC"
    },
    "mobile": {
      "type": "string"
    },
    "mobile_verified": {
      "type": "boolean",
      "default": false
    },
    "email_verified": {
      "type": "boolean",
      "default": true
    },
    "response_rate": {
      "type": "number",
      "default": 100
    },
    "avg_response_minutes": {
      "type": "number",
      "default": 60
    },
    "completed_jobs": {
      "type": "number",
      "default": 0
    },
    "abandoned_posts": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id",
    "full_name"
  ],
  // created_by is stamped by the server and cannot be forged, unlike data.user_id
  // which the client supplies. Pinning to both stops another account from planting
  // a record that the victim's `filter({ user_id })` would pick up as their own.
  "rls": {
    "create": { "user_condition": { "id": "{{user.id}}" } },
    "read": {
      "$and": [
        { "created_by": "{{user.email}}" },
        { "data.user_id": "{{user.id}}" }
      ]
    },
    "update": {
      "$and": [
        { "created_by": "{{user.email}}" },
        { "data.user_id": "{{user.id}}" }
      ]
    },
    "delete": {
      "$and": [
        { "created_by": "{{user.email}}" },
        { "data.user_id": "{{user.id}}" }
      ]
    }
  }
}
