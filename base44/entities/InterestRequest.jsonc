{
  "name": "InterestRequest",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "tradie_id": {
      "type": "string"
    },
    "tradie_name": {
      "type": "string"
    },
    "tradie_business": {
      "type": "string"
    },
    "quote_low": {
      "type": "number"
    },
    "quote_high": {
      "type": "number"
    },
    "earliest_availability": {
      "type": "string",
      "format": "date"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "expired"
      ],
      "default": "pending"
    },
    "response_deadline": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "job_id",
    "tradie_id",
    "status"
  ],
  // Created by send-interest / respond-invitation, which verify the job is open and
  // the tradie holds a paid or trial plan — an entitlement check that used to live
  // only in the browser. Status transitions belong to accept-interest, which proves
  // the caller owns the job, so update stays closed to the client.
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$and": [
        { "user_condition": { "id": "{{user.id}}" } },
        {
          "$or": [
            { "data.customer_id": "{{user.id}}" },
            { "data.tradie_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": false
  }
}
