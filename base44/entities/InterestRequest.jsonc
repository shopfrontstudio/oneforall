{
  "name": "InterestRequest",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string",
      "description": "Safe service label, never customer-authored title text."
    },
    "service_key": { "type": "string" },
    "selected_scope_ids": { "type": "array", "items": { "type": "string" } },
    "idempotency_key": { "type": "string" },
    "policy_version": { "type": "string" },
    "booking_id": { "type": "string" },
    "customer_id": {
      "type": "string",
      "description": "Routing identifier hidden from the provider until a booking exists.",
      "rls": {
        "read": {
          "$or": [
            { "data.customer_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      }
    },
    "tradie_id": {
      "type": "string"
    },
    "attending_worker_id": { "type": "string" },
    "attending_worker_display_name": { "type": "string" },
    "worker_relationship_label": { "type": "string" },
    "substitution_disclosed": { "type": "boolean", "default": false },
    "tradie_name": {
      "type": "string"
    },
    "tradie_business": {
      "type": "string"
    },
    "provider_assertion_id": { "type": "string" },
    "provider_assertion_evidence_checked_date": { "type": "string", "format": "date" },
    "provider_assertion_valid_through": { "type": "string", "format": "date" },
    "quote_low": {
      "type": "number"
    },
    "quote_high": {
      "type": "number"
    },
    "earliest_availability": {
      "type": "string",
      "format": "date"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "expired"
      ],
      "default": "pending"
    },
    "response_deadline": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "job_id",
    "tradie_id",
    "status"
  ],
  // Created by send-interest / respond-invitation, which verify the request is open
  // and service-level provider eligibility passes. Status transitions belong to accept-interest, which proves
  // the caller owns the job, so update stays closed to the client.
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$and": [
        { "user_condition": { "id": "{{user.id}}" } },
        {
          "$or": [
            { "data.customer_id": "{{user.id}}" },
            { "data.tradie_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": false
  }
}
