{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "tradie_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "conversation_id",
    "sender_id",
    "body"
  ],
  // Messages are written only by the send-message function, which checks that the
  // caller is actually a participant in conversation_id and then stamps sender_id,
  // sender_name, customer_id and tradie_id from the session and the conversation.
  // Closing create to the client is the part that makes those fields trustworthy —
  // RLS gates who may write, never what the row contains.
  //
  // Nothing edits or deletes messages, so both stay closed rather than being pinned
  // to a client-supplied sender_id.
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$and": [
        { "user_condition": { "id": "{{user.id}}" } },
        {
          "$or": [
            { "data.customer_id": "{{user.id}}" },
            { "data.tradie_id": "{{user.id}}" },
            { "user_condition": { "role": "admin" } }
          ]
        }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
