{
  "name": "Boost",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "free",
        "paid"
      ],
      "default": "free"
    }
  },
  "required": [
    "job_id",
    "customer_id",
    "type"
  ],
  "rls": {
    "create": true,
    "read": { "data.customer_id": "{{user.id}}" },
    "update": { "data.customer_id": "{{user.id}}" },
    "delete": { "data.customer_id": "{{user.id}}" }
  }
}
